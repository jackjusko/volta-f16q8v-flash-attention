+template<int stride_tile, int nwarps, int nbatch_fa, int tile_d2, int values_per_chunk, bool oob_check>
+static __device__ __forceinline__ void flash_attn_ext_q8_0_load_v_tile(
+        const void * V, half2 * tile_V, const int stride_bytes, const int row_start, const int valid_rows,
+        const int d_start) {
+    constexpr int warp_size = ggml_cuda_get_physical_warp_size();
+    constexpr int chunks_per_row = 2*tile_d2 / values_per_chunk;
+    static_assert(values_per_chunk == 8 || values_per_chunk == 32);
+    static_assert(2*tile_d2 % values_per_chunk == 0 && QK8_0 % values_per_chunk == 0);
+
+    for (int chunk = threadIdx.y*warp_size + threadIdx.x; chunk < nbatch_fa*chunks_per_row; chunk += nwarps*warp_size) {
+        const int row = chunk / chunks_per_row;
+        const int d = (chunk % chunks_per_row)*values_per_chunk;
+        alignas(16) half2 values[values_per_chunk/2] = {};
+        if (!oob_check || row < valid_rows) {
+            const char * src = static_cast<const char *>(V) + int64_t(row_start + row)*stride_bytes;
+            const int64_t value_i = d_start + d;
+            if constexpr (values_per_chunk == 32) {
+                if (value_i % values_per_chunk == 0) {
+                    const block_q8_0 * block = reinterpret_cast<const block_q8_0 *>(src) + value_i / QK8_0;
+                    alignas(16) int8_t qs[values_per_chunk];
+                    ggml_cuda_memcpy_1<16, 2>(qs, block->qs);
+                    ggml_cuda_memcpy_1<16, 2>(qs + 16, block->qs + 16);
+                    const half2 scale = __half2half2(block->d);
+#pragma unroll
+                    for (int i = 0; i < values_per_chunk; i += 2) {
+                        values[i/2] = scale * make_half2(qs[i], qs[i + 1]);
+                    }
+                } else {
+#pragma unroll
+                    for (int i = 0; i < values_per_chunk; i += 8) {
+                        dequantize_V_q8_0<half, 8>(src, values + i/2, value_i + i);
+                    }
+                }
+            } else {
+                dequantize_V_q8_0<half, 8>(src, values, value_i);
+            }
+        }
+        half2 * dst = swizzle<stride_tile>(tile_V, row*stride_tile + d/2, row);
+        ggml_cuda_memcpy_1<16>(dst, values);
+        if constexpr (values_per_chunk == 32) {
+            ggml_cuda_memcpy_1<16>(dst + 4, values + 4);
+            ggml_cuda_memcpy_1<16>(dst + 8, values + 8);
+            ggml_cuda_memcpy_1<16>(dst + 12, values + 12);
+        }
+    }
+}
